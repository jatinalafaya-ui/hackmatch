@startuml sequence-password-reset
skinparam shadowing false
skinparam sequenceParticipantBackgroundColor #E8EDF9
skinparam sequenceParticipantBorderColor #1E3A8A
autonumber

actor User
participant "Web / mobile client" as UI
participant "Express\n/api/auth" as API
database "MongoDB Atlas" as DB
participant "Nodemailer\n(Gmail SMTP)" as Mail

User -> UI : Forgot password? enters email
UI -> API : POST /forgot-password { email }
API -> DB : findOne({ email })
opt account exists
  API -> DB : delete old reset tokens, save SHA-256(token), expires in 30 min
  API -> Mail : send link /reset-password?token=...
  Mail --> User : reset email
end
API --> UI : 200 "If an account exists..."\n(same answer either way)
User -> UI : opens link, types new password
UI -> API : POST /reset-password { token, password }
API -> DB : findOneAndDelete({ tokenHash, expiresAt > now })
alt token valid
  API -> DB : save bcrypt hash of new password
  API --> UI : 200 "Password updated"
else expired or reused
  API --> UI : 400 "invalid or has expired"
end
@enduml
