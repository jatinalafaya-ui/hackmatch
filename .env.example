# Copy to .env for local development. Never commit the real values.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=
MONGODB_DB=hackmatch

# Long random string used to sign login tokens
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public address of the web app, used in emailed links
APP_URL=http://localhost:5173

# Extra allowed browser origins in production, comma separated
CORS_ORIGINS=

# SMTP account for verification and reset emails (Gmail: smtp.gmail.com, 465, app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
