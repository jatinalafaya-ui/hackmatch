{
  "name": "hackmatch",
  "version": "1.0.0",
  "private": true,
  "description": "Find hackathon teammates and mentors. Express + MongoDB API for the HackMatch web and mobile apps.",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "seed": "node server/src/seed.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"server/tests/*.test.js\"",
    "lint": "eslint server api",
    "build": "npm run build --prefix web"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
